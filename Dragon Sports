            document.getElementById('searchModal').classList.remove('flex');
        }

        function handleSearch(e) {
            if(e && e.key === 'Enter') {
                const query = document.getElementById('searchInput').value;
                closeSearchModal();
                nav('shop', {query: query});
                return;
            }
            
            const query = document.getElementById('searchInput').value;
            const resContainer = document.getElementById('searchResults');
            
            if(query.length < 2) {
                resContainer.innerHTML = '<div class="p-4 text-sm text-gray-500">Type at least 2 characters...</div>';
                return;
            }

            const results = fuse.search(query).slice(0, 5); // top 5
            
            if(results.length === 0) {
                resContainer.innerHTML = '<div class="p-4 text-sm text-gray-400 text-center"><i class="fas fa-frown mb-2 text-2xl"></i><br>No products found</div>';
                return;
            }

            resContainer.innerHTML = results.map(result => {
                const p = result.item;
                return `
                    <div class="flex items-center gap-3 p-3 hover:bg-gray-800 cursor-pointer border-b border-gray-800 last:border-0" onclick="closeSearchModal(); nav('product', {id: '${p.id}'})">
                        <img src="${p.image}" class="w-12 h-12 rounded object-cover">
                        <div>
                            <div class="font-medium text-sm line-clamp-1">${p.name}</div>
                            <div class="text-xs text-gray-500">${p.sport} • ₹${p.price}</div>
                        </div>
                    </div>
                `;
            }).join('');
        }
        
        function simulateVoiceSearch() {
            document.getElementById('searchInput').value = "Listening...";
            setTimeout(() => {
                document.getElementById('searchInput').value = "Football Shoes";
                handleSearch();
            }, 1500);
        }

        // Initialize App
        window.onload = () => {
            updateState(); // Load state from local storage
            nav('home'); // Start on home page
            
            // Header scroll effect
            window.addEventListener('scroll', () => {
                const header = document.getElementById('mainHeader');
                if (window.scrollY > 50) {
                    header.classList.add('shadow-lg', 'bg-bg-dark/95');
                    header.classList.remove('glass-nav');
                } else {
                    header.classList.remove('shadow-lg', 'bg-bg-dark/95');
                    header.classList.add('glass-nav');
                }
            });
        };
    </script>
</body>
</html>
