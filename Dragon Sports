        function addToCart(productId, quantity = 1) {
            const product = db.products.find(p => p.id === productId);
            if(!product) return;

            const existingItem = state.cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.qty += quantity;
            } else {
                state.cart.push({ ...product, qty: quantity });
            }
            
            updateState();
            showToast(`${product.name} added to cart!`);
            
            // Animation effect on cart icon
            const cartIcon = document.getElementById('cartCount');
            cartIcon.classList.add('animate-ping');
            setTimeout(() => cartIcon.classList.remove('animate-ping'), 300);
        }

        function buyNow(productId) {
            // Clear cart and add single item for direct buy
            state.cart = [];
            addToCart(productId);
            nav('cart');
        }

        function updateCartQty(productId, change) {
            const item = state.cart.find(i => i.id === productId);
            if(item) {
                item.qty += change;
                if(item.qty <= 0) {
                    removeFromCart(productId);
                } else {
                    updateState();
                    if(document.getElementById('page-cart').classList.contains('active')) renderCart();
                }
            }
        }

        function removeFromCart(productId) {
            state.cart = state.cart.filter(i => i.id !== productId);
            updateState();
            if(document.getElementById('page-cart').classList.contains('active')) renderCart();
        }

        let currentDiscountPercentage = 0;

        function renderCart() {
            const container = document.getElementById('cartItemsList');
            const emptyState = document.getElementById('cartEmptyState');
            
            if (state.cart.length === 0) {
                container.innerHTML = '';
                emptyState.classList.remove('hidden');
                document.getElementById('cartHeaderCount').innerText = '0';
                updateCartSummary();
                return;
            }

            emptyState.classList.add('hidden');
            document.getElementById('cartHeaderCount').innerText = state.cart.length;

            container.innerHTML = state.cart.map(item => `
                <div class="flex gap-4 bg-bg-card p-4 rounded-xl border border-gray-800 relative">
                    <button onclick="removeFromCart('${item.id}')" class="absolute top-2 right-2 text-gray-500 hover:text-primary transition-colors p-2">
                        <i class="fas fa-times"></i>
                    </button>
                    
                    <div class="w-24 h-24 bg-gray-900 rounded-lg overflow-hidden flex-shrink-0 cursor-pointer" onclick="nav('product', {id: '${item.id}'})">
                        <img src="${item.image}" class="w-full h-full object-cover">
                    </div>
                    
                    <div class="flex flex-col flex-grow justify-between">
                        <div>
                            <h4 class="font-bold text-sm md:text-base pr-6 line-clamp-2">${item.name}</h4>
                            <p class="text-xs text-gray-400 mt-1">${item.sizes ? 'Size: ' + item.sizes[0] : ''} | ${item.brand}</p>
                        </div>
                        
                        <div class="flex justify-between items-end mt-2">
                            <div class="flex items-center border border-gray-700 rounded bg-gray-900">
                                <button onclick="updateCartQty('${item.id}', -1)" class="px-3 py-1 hover:text-primary">-</button>
                                <span class="px-2 font-medium text-sm">${item.qty}</span>
                                <button onclick="updateCartQty('${item.id}', 1)" class="px-3 py-1 hover:text-primary">+</button>
                            </div>
                            <div class="text-right">
                                ${item.mrp > item.price ? `<div class="text-xs text-gray-500 line-through">₹${item.mrp * item.qty}</div>` : ''}
                                <div class="font-bold text-lg">₹${item.price * item.qty}</div>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');

            updateCartSummary();
        }

        function applyCoupon() {
            const code = document.getElementById('couponCode').value.toUpperCase();
            const msg = document.getElementById('couponMsg');
            
            if (code === 'DRAGON10' || code === 'DIWALI20') {
                currentDiscountPercentage = code === 'DIWALI20' ? 20 : 10;
                msg.innerText = `Coupon ${code} applied successfully!`;
                msg.className = "text-xs mt-1 text-green-500 block";
                document.getElementById('discountRow').classList.remove('hidden');
                document.getElementById('appliedCouponLabel').innerText = code;
            } else {
                currentDiscountPercentage = 0;
                msg.innerText = "Invalid coupon code";
                msg.className = "text-xs mt-1 text-primary block";
                document.getElementById('discountRow').classList.add('hidden');
            }
            updateCartSummary();
        }

        function updateCartSummary() {
            const subtotal = state.cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const delivery = subtotal > 999 || subtotal === 0 ? 0 : 99;
            const discount = Math.floor(subtotal * (currentDiscountPercentage / 100));
            const total = subtotal - discount + delivery;

            document.getElementById('cartSubtotal').innerText = `₹${subtotal}`;
            document.getElementById('cartDelivery').innerText = delivery === 0 ? 'Free' : `₹${delivery}`;
            document.getElementById('cartDiscount').innerText = `-₹${discount}`;
            document.getElementById('cartTotal').innerText = `₹${total}`;
            
            // Update checkout total too
            document.getElementById('checkoutTotalAmount').innerText = `₹${total}`;
        }

        // Checkout Navigation
        function nextCheckoutStep(step) {
            document.querySelectorAll('.checkout-step').forEach(el => el.classList.add('hidden'));
            document.getElementById(`checkoutStep${step}`).classList.remove('hidden');
            
            // Update indicator
            document.querySelectorAll('.step-indicator').forEach(el => {
                if(parseInt(el.dataset.step) <= step) {
                    el.classList.add('active');
                    el.querySelector('div').classList.replace('bg-gray-800', 'bg-primary');
                    el.querySelector('div').classList.replace('text-gray-400', 'text-white');
                } else {
                    el.classList.remove('active');
                }
            });

            // Update Progress line
            const line = document.getElementById('progressLine');
            if(step === 1) line.style.width = '10%';
            if(step === 2) line.style.width = '50%';
            if(step === 3) line.style.width = '100%';
        }

        function placeOrder() {
            if(state.cart.length === 0) return;
            
            const total = document.getElementById('cartTotal').innerText;
            const orderId = '#DS-' + Math.floor(100000 + Math.random() * 900000);
            
            const newOrder = {
                id: orderId,
                date: new Date().toLocaleDateString(),
                total: total,
                status: 'Order Confirmed',
                items: [...state.cart]
            };
            
            state.orders.unshift(newOrder);
            state.cart = []; // Empty cart
            updateState();
            
            document.getElementById('successOrderId').innerText = orderId;
            nextCheckoutStep(3);
        }

        function toggleWishlist(productId, event) {
            if(event) event.stopPropagation(); // prevent card click
            
            const index = state.wishlist.indexOf(productId);
            if (index > -1) {
                state.wishlist.splice(index, 1);
                showToast('Removed from wishlist');
            } else {
                state.wishlist.push(productId);
                showToast('Added to wishlist');
            }
            updateState();
            
            // Re-render current view to update heart icons
            if(document.getElementById('page-home').classList.contains('active')) renderHome();
            if(document.getElementById('page-shop').classList.contains('active')) applyFilters();
        }

        function updateState() {
            localStorage.setItem('dragonCart', JSON.stringify(state.cart));
            localStorage.setItem('dragonWishlist', JSON.stringify(state.wishlist));
            localStorage.setItem('dragonOrders', JSON.stringify(state.orders));
            
            // Update counters
            const cartCount = state.cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cartCount').innerText = cartCount;
            document.getElementById('mobCartCount').innerText = cartCount;
            
            const wishCount = state.wishlist.length;
            const wishEl = document.getElementById('wishlistCount');
            wishEl.innerText = wishCount;
            if(wishCount > 0) wishEl.classList.remove('hidden');
            else wishEl.classList.add('hidden');
        }

