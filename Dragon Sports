        function renderShopFilters() {
            // Get unique brands and sports
            const sports = [...new Set(db.products.map(p => p.sport))].sort();
            const brands = [...new Set(db.products.map(p => p.brand))].sort();

            const createCheckbox = (type, val, label) => `
                <label class="flex items-center space-x-2 cursor-pointer text-sm text-gray-300 hover:text-white">
                    <input type="checkbox" onchange="updateFilterState('${type}', '${val}', this.checked)" 
                        ${currentFilterState[type] === val ? 'checked' : ''}
                        class="rounded bg-gray-800 border-gray-700 text-primary focus:ring-primary">
                    <span>${label}</span>
                </label>
            `;

            document.getElementById('filterSports').innerHTML = sports.map(s => createCheckbox('sport', s, s)).join('');
            document.getElementById('filterBrands').innerHTML = brands.map(b => createCheckbox('brand', b, b)).join('');
        }

        function updateFilterState(type, val, isChecked) {
            if(isChecked) {
                currentFilterState[type] = val; // Simple demo: single select per category
            } else {
                currentFilterState[type] = 'all';
            }
            applyFilters();
        }

        function applyFilters() {
            let results = db.products;

            // Apply search
            if (currentFilterState.query) {
                results = fuse.search(currentFilterState.query).map(result => result.item);
            }

            // Apply Filters
            if (currentFilterState.sport !== 'all') results = results.filter(p => p.sport === currentFilterState.sport);
            if (currentFilterState.category !== 'all') results = results.filter(p => p.category === currentFilterState.category);
            if (currentFilterState.brand !== 'all') results = results.filter(p => p.brand === currentFilterState.brand);
            if (currentFilterState.offer) results = results.filter(p => p.discount >= 20); // Demo logic for offers

            // Apply Sorting
            const sort = document.getElementById('sortSelect').value;
            if (sort === 'price-low') results.sort((a, b) => a.price - b.price);
            if (sort === 'price-high') results.sort((a, b) => b.price - a.price);
            if (sort === 'rating') results.sort((a, b) => b.rating - a.rating);
            if (sort === 'discount') results.sort((a, b) => b.discount - a.discount);

            // Render
            const grid = document.getElementById('shopGrid');
            const noMsg = document.getElementById('noProductsMsg');
            
            if (results.length === 0) {
                grid.innerHTML = '';
                noMsg.classList.remove('hidden');
            } else {
                noMsg.classList.add('hidden');
                grid.innerHTML = results.map(p => createProductCard(p)).join('');
            }

            // Close mobile filters if open
            const sidebar = document.getElementById('filterSidebar');
            if(window.innerWidth < 768 && !sidebar.classList.contains('hidden')) {
                toggleFilters();
            }
        }

        function toggleFilters() {
            const sidebar = document.getElementById('filterSidebar');
            sidebar.classList.toggle('hidden');
        }
        function resetFilters() {
            currentFilterState = { sport: 'all', category: 'all', brand: 'all', query: '' };
            renderShopFilters();
            applyFilters();
        }

