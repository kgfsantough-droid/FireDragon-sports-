    <script>
        // --- ROUTING & NAVIGATION ---
        let currentFilterState = { sport: 'all', category: 'all', brand: 'all', query: '' };

        function nav(page, params = {}) {
            // Hide all pages
            document.querySelectorAll('.page-section').forEach(el => {
                el.classList.remove('active');
            });
            
            // Show requested page
            const target = document.getElementById(`page-${page}`) || document.getElementById('page-shop'); // Fallback to shop
            target.classList.add('active');
            window.scrollTo(0, 0);

            // Update mobile nav highlight
            document.querySelectorAll('[id^="mob-nav-"]').forEach(el => el.classList.replace('text-white', 'text-gray-400'));
            if(document.getElementById(`mob-nav-${page}`)) {
                document.getElementById(`mob-nav-${page}`).classList.replace('text-gray-400', 'text-white');
            }

            // Page specific logic
            if (page === 'home') renderHome();
            else if (page === 'shop' || page === 'categories' || page === 'offers') {
                document.getElementById('page-shop').classList.add('active');
                
                // Set filters based on params
                currentFilterState = { sport: 'all', category: 'all', brand: 'all', query: '' };
                if (params.category) currentFilterState.category = params.category;
                if (params.sport) currentFilterState.sport = params.sport;
                if (params.query) currentFilterState.query = params.query;
                
                let title = 'All Products';
                if(page === 'offers') { currentFilterState.offer = true; title = '🔥 Diwali Mega Offers'; }
                if(params.category) title = params.category + ' Gear';
                if(params.sport) title = params.sport + ' Store';
                if(params.query) title = `Search: "${params.query}"`;
                
                document.getElementById('shopTitle').innerHTML = title;
                renderShopFilters();
                applyFilters();
            }
            else if (page === 'product' && params.id) renderProductDetail(params.id);
            else if (page === 'cart') renderCart();
            else if (page === 'account') renderOrders();
